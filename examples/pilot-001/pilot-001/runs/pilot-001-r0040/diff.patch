+from typing import List, Optional
+
+
+def parse_int_list(s: Optional[str]) -> List[int]:
+    """
+    Parse a comma-separated string into a list of integers.
+
+    - None or empty/whitespace-only string returns [].
+    - Invalid tokens (non-integer after stripping) are skipped.
+    - Valid inputs retain their current behavior: whitespace around tokens is allowed,
+      and negative numbers like "-7" are valid.
+    """
+    if s is None or s.strip() == '':
+        return []
+    tokens = [t.strip() for t in s.split(',')]
+    result = []
+    for token in tokens:
+        if token:
+            try:
+                result.append(int(token))
+            except ValueError:
+                pass
+    return result
