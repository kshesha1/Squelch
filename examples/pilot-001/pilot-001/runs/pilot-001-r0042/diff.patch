+"""
+Thoroughly modernized parse.py to handle edge cases.
+
+- None or empty string → returns []
+- Non-integer tokens are skipped
+- Preserves original behavior for valid inputs
+"""
+
 def parse_int_list(s):
     """Parse a comma-separated string of integers into a list."""
-    return [int(token.strip()) for token in s.split(",")]
+    if s is None or s.strip() == '':
+        return []
+    result = []
+    for token in s.split(','): 
+        stripped = token.strip()
+        if stripped:
+            try:
+                result.append(int(stripped))
+            except ValueError:
+                pass
+    return result
