+def parse_int_list(s: str | None) -> list[int]:
+    """
+    Parse a comma-separated string into a list of integers.
+
+    - None or empty/whitespace-only input returns an empty list.
+    - Non-integer tokens are skipped.
+    - Valid integers (including negatives) are included as integers.
+    - Whitespace around tokens is allowed and ignored.
+
+    Args:
+        s: The input string or None.
+
+    Returns:
+        List of integers parsed from the input.
+    """
+    if s is None or s.strip() == '':
+        return []
+    parts = s.split(',')
+    result = []
+    for part in parts:
+        stripped = part.strip()
+        if stripped:
+            try:
+                num = int(stripped)
+                result.append(num)
+            except ValueError:
+                pass
+    return result
